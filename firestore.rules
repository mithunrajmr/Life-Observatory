rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Explicit root user document
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Explicit subcollection rules - NO recursive wildcards
      match /reflections/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid &&
          isValidString(request.resource.data.content, 1, 10000);
      }

      match /conversations/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid;
      }

      match /events/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid &&
          isValidString(request.resource.data.title, 1, 500);
      }

      match /goals/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid &&
          isValidString(request.resource.data.title, 1, 500);
      }

      match /decisions/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid &&
          isValidString(request.resource.data.title, 1, 500);
      }

      match /predictions/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid;
      }

      match /outcomes/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid;
      }

      match /patterns/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid;
      }

      match /turningPoints/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid &&
          isValidString(request.resource.data.title, 1, 500);
      }

      match /evidence/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid;
      }

      match /insights/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid;
      }

      match /snapshots/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid;
      }

      match /connections/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
          request.resource.data.userId == uid;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
